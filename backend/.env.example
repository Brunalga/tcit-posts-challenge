NODE_ENV=development
PORT=4000

# Assumes `pnpm db:up` (Postgres in Docker, published on localhost:5432) with
# the backend itself running on the host via `pnpm start` / `pnpm --prefix
# backend run dev`. Running the *whole* stack via `docker compose up` instead
# doesn't read this file at all — docker-compose.yml sets DATABASE_URL to
# postgresql://postgres:postgres@db:5432/tcit_posts?schema=public itself.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tcit_posts?schema=public

CORS_ORIGIN=http://localhost:5173

# How long a completed Idempotency-Key record is honored for replay before
# the key becomes reusable again.
IDEMPOTENCY_KEY_TTL_HOURS=24
