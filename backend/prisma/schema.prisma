// Prisma schema for the TCIT Posts challenge.
//
// Naming convention: model fields are camelCase (consumed as-is by TS/JSON),
// underlying Postgres columns/tables are snake_case, mapped via @map/@@map.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Post {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @db.VarChar(255)
  description String   @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("posts")
}

// Backs the Idempotency-Key mechanism on POST /api/posts.
// Every mutating request that declares an Idempotency-Key is recorded here
// so retries with the same key are replayed instead of re-executed.
model IdempotencyKey {
  // The client-supplied idempotency key (a UUID in this implementation).
  key                String   @id @db.VarChar(255)
  // Hash of {method, path, body} so a key reused with a *different* payload
  // is detected and rejected (409) instead of silently replaying a mismatch.
  requestFingerprint String   @map("request_fingerprint") @db.VarChar(64)
  // "processing" while the original request is in flight, "completed" once
  // a response has been captured. A row stuck in "processing" past its TTL
  // is treated as abandoned and is safe to reclaim.
  status             String   @default("processing") @db.VarChar(20)
  responseStatusCode Int?     @map("response_status_code")
  responseBody       Json?    @map("response_body")
  createdAt          DateTime @default(now()) @map("created_at")
  expiresAt          DateTime @map("expires_at")

  @@map("idempotency_keys")
}
